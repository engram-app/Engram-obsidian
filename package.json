{
  "name": "engram-obsidian",
  "version": "1.9.21",
  "description": "Your notes are your AI's memory. Sync your vault everywhere, search by meaning, and let Claude, Cursor, and other AI apps read and write your notes. Hosted or self-host, free to start.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check src tests",
    "lint:obsidian": "eslint --max-warnings 0 'src/**/*.ts'",
    "lint:css": "stylelint --max-warnings 0 styles.css",
    "format": "biome format --write src tests",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "prepare": "lefthook install"
  },
  "keywords": [
    "obsidian",
    "engram",
    "sync",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^1.2.0",
    "@types/bun": "^1.2.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "lefthook": "^2.1.6",
    "obsidian": "1.8.7",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "lib0": "^0.2.117",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "overrides": {
    "brace-expansion": "^1.1.13",
    "picomatch": "^2.3.2",
    "js-yaml": "4.2.0"
  }
}
